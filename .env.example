# Kopier til .env.local og fyll inn. .env.local skal ALDRI committes.
NVDB_API_BASE=https://nvdbapiles.atlas.vegvesen.no
# Identifiserer appen overfor Statens vegvesen (påkrevd header X-Client)
NVDB_X_CLIENT=nvdb-objektkatalog
# Tilkoblingsstreng fra Neon (Connect > pooled). Hemmelig, fyll inn bare i .env.local
DATABASE_URL=

# Google OAuth-klient fra Google Cloud Console. Hemmelig.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Adressen appen kjører på (https i produksjon)
BETTER_AUTH_URL=http://localhost:3000
# Lag med: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Kommaseparert liste over Google-kontoer som får logge inn som admin
ADMIN_EMAILS=
